    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Upsert: ElevenLabs may redeliver the same event; the last delivery wins.\nINSERT INTO calls (conversation_id, customer_id, duration_sec, outcome, transcript, metadata)\nVALUES (\n    $1,\n    (SELECT id FROM customers WHERE customer_code = $2),\n    $3::integer,\n    $4,\n    $5,\n    $6::jsonb\n)\nON CONFLICT (conversation_id) DO UPDATE SET\n    customer_id  = EXCLUDED.customer_id,\n    duration_sec = EXCLUDED.duration_sec,\n    outcome      = EXCLUDED.outcome,\n    transcript   = EXCLUDED.transcript,\n    metadata     = EXCLUDED.metadata\nRETURNING id, (xmax = 0) AS inserted;",
        "options": {
          "queryReplacement": "={{ [ $json.conversation_id, $json.customer_code, $json.duration_sec, $json.outcome, $json.transcript, JSON.stringify($json.metadata) ] }}"
        }
