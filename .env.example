# Copy this file to .env and replace every value marked CHANGE_ME.
# .env is git-ignored; never commit real secrets.

# ---------- PostgreSQL (container) ----------
# Superuser used by the postgres image on first start.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
# Default database created by the image; the init script adds "n8n" and "voltaluce".
POSTGRES_DB=postgres
# Host port exposed on your machine (5432 is taken by another local project).
POSTGRES_HOST_PORT=5433

# Dedicated role used by the n8n service for its own internal tables.
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_n8n_db_password

# Dedicated role used by the workflows to read/write the application tables.
APP_DB_USER=voltaluce_app
APP_DB_PASSWORD=CHANGE_ME_app_db_password

# ---------- n8n ----------
# Host port exposed on your machine (5678 is taken by another local n8n).
N8N_HOST_PORT=5679
# Encrypts credentials stored in the n8n database. Generate with:
#   openssl rand -hex 32
# Losing it makes every saved credential unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME_random_hex_64_chars
# Public URL n8n uses to build webhook URLs. Local by default;
# set to the tunnel URL (https://xxxx.trycloudflare.com) when exposing to ElevenLabs.
N8N_WEBHOOK_URL=http://localhost:5679/
GENERIC_TIMEZONE=Europe/Rome

# ---------- Webhook security ----------
# Shared secret ElevenLabs must send in the "x-api-key" header on every tool call.
# Generate with:  openssl rand -hex 32
WEBHOOK_API_KEY=CHANGE_ME_random_hex_64_chars
# Signing secret shown by ElevenLabs when you create the post-call webhook
# (Agents -> Settings -> Post-call webhooks). Used to verify the HMAC signature.
ELEVENLABS_POSTCALL_SECRET=CHANGE_ME_from_elevenlabs_dashboard
